#!/usr/bin/env python3
"""Factory evals: structural, routing and gate-hold tiers.

  run structural                 offline, fast: frontmatter, references, scenario files
  run routing   [--runs N]       does omp pick (or refuse) the right skill for a prompt
  run gate-hold [--scenario NN]  plant one fault in a throwaway repo, run omp, judge the result

See omp/factory-evals/README.md. Python 3.9, standard library only.
"""
import argparse
import concurrent.futures as cf
import datetime
import json
import os
import py_compile
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent.parent  # dotfiles repo root
SKILLS_DIR = ROOT / "skills"
AGENTS_DIR = ROOT / "omp" / "agents"
SCENARIOS_DIR = HERE / "scenarios"
BASE_DIR = SCENARIOS_DIR / "_base"
HOME = Path(os.path.expanduser("~"))
STATE_TOOL = HOME / ".omp" / "agent" / "skills" / "factory" / "scripts" / "factory-state"
if not STATE_TOOL.exists():  # skills not linked yet: use the repo copy
    STATE_TOOL = ROOT / "skills" / "factory" / "scripts" / "factory-state"

DEFAULT_JUDGE = "openai-codex/gpt-6.1-sol:high"
DEFAULT_JUDGE_FOR_GPT = "anthropic/claude-opus-5-5:high"

# ---------------------------------------------------------------- contract data

# Skills that must set disable-model-invocation: true (factory-contract.md).
DISABLE_MODEL_INVOCATION = [
    "factory", "feature", "factory-grill", "factory-gate", "factory-requirements",
    "factory-stack", "factory-architecture", "factory-issues", "factory-bootstrap",
    "factory-build", "factory-land", "factory-review",
]
EXPECTED_SKILLS = DISABLE_MODEL_INVOCATION + ["tour"]
EXPECTED_AGENTS = [
    "factory-builder-check", "factory-design-director", "factory-planner", "factory-qa-author",
    "factory-designer", "factory-design-review", "factory-builder", "factory-builder-unstick",
    "factory-spec-review", "factory-test-review", "factory-qa", "factory-qa-review",
    "factory-ui-review", "factory-explainer",
]
EXPECTED_FILES = [
    ("omp/hooks/pre/factory-guard.ts", False),
    ("omp/extensions/factory-stage-guard.ts", False),
    ("skills/factory/scripts/factory-state", True),
    ("omp/factory-evals/run", True),
]
# Third-party skills the integrator installs; missing is a warning, not a failure.
THIRD_PARTY_SKILLS = {"ponytail", "archify"}
# `factory-*` words that are neither skills nor agents.
NON_AGENT_TOKENS = {
    "factory-state", "factory-guard", "factory-stage-guard", "factory-evals", "factory-archive",
}
FORBIDDEN_AGENT_KEYS = {"structured", "output"}
SKILL_MAX_LINES = 150

# ---------------------------------------------------------------- routing cases

# id, prompt, must_read (skill names), must_not_read (skill names)
FACTORY_SKILLS = [s for s in EXPECTED_SKILLS if s != "tour"]
ROUTING_CASES = [
    ("R1", "What features does this project have? Just list them.", ["tour"], []),
    ("R2", "I want to build a whole habit-tracker app from scratch. Where do I start?", [], FACTORY_SKILLS),
    ("R3", "Fix the typo 'recieve' in README.md.", [], FACTORY_SKILLS + ["tour"]),
    ("R4", "/skill:factory status", ["factory"], ["feature"]),
    ("R5", "/skill:feature add a dark mode toggle to the settings page", ["feature"], ["factory"]),
]

# ---------------------------------------------------------------- gh stub

GH_STUB = r"""#!/usr/bin/env bash
# Eval stub for gh: logs every call, answers from $EVAL_GH_DATA/<arg1>_<arg2>.out.
data="${EVAL_GH_DATA:?}"; log="${EVAL_GH_LOG:?}"
echo "gh $*" >> "$log"
[ "${1:-}" = "auth" ] && { echo "Logged in to github.com (eval stub)"; exit 0; }
key="${1:-}_${2:-}"
if [ -f "$data/$key.out" ]; then cat "$data/$key.out"; exit 0; fi
case "$key" in
  pr_edit|pr_comment|pr_review|issue_comment|issue_edit|issue_close|pr_merge|pr_create) exit 0 ;;
esac
echo "gh eval stub: no recorded answer for: $*" >&2
exit 1
"""

HARNESS_NOTE = (
    "\n\n[Harness note: this is a non-interactive run. The `ask` tool is not available and nobody "
    "can answer. Where a gate or question needs the user, present it in chat and stop; it counts "
    "as No. Do not wait.]"
)

# ---------------------------------------------------------------- frontmatter


def parse_frontmatter(text):
    """Return (dict, body_start_line_index) or (None, 0). Handles `key: v`, folded `>` / `|`."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None, 0
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            end = i
            break
    if end is None:
        return None, 0
    fm = {}
    i = 1
    while i < end:
        m = re.match(r"^([A-Za-z][\w-]*):\s*(.*)$", lines[i])
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2).strip()
        if val in (">", "|", ">-", "|-", ">+", "|+"):
            block = []
            i += 1
            while i < end and (lines[i].startswith(" ") or lines[i].strip() == ""):
                block.append(lines[i].strip())
                i += 1
            val = " ".join(b for b in block if b)
        else:
            i += 1
            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                val = val[1:-1]
        fm[key] = val
    return fm, end + 1


# ---------------------------------------------------------------- scenario files

FENCE_RE = re.compile(r"^```(.*)$")


def parse_scenario(path):
    """Parse a scenario markdown file into a dict."""
    text = Path(path).read_text()
    lines = text.split("\n")
    blocks = []  # (kind, attrs, content)
    prose = {}  # section -> text without fenced blocks
    section = None
    i = 0
    while i < len(lines):
        line = lines[i]
        m = FENCE_RE.match(line)
        if m:
            info = m.group(1).strip()
            body = []
            i += 1
            while i < len(lines) and not lines[i].startswith("```"):
                body.append(lines[i])
                i += 1
            i += 1
            words = info.split()
            kind = words[0] if words else ""
            attrs = {}
            for w in words[1:]:
                if "=" in w:
                    k, v = w.split("=", 1)
                    attrs[k] = v
                else:
                    attrs[w] = True
            blocks.append((kind, attrs, "\n".join(body) + "\n"))
            continue
        h = re.match(r"^## (.+)$", line)
        if h:
            section = h.group(1).strip().lower()
            prose.setdefault(section, [])
        elif section is not None:
            prose[section].append(line)
        i += 1
    title = lines[0].lstrip("# ").strip() if lines else path.name
    base = None
    for ln in prose.get("setup", []):
        m = re.match(r"^base:\s*(\S+)", ln)
        if m:
            base = m.group(1)
    return {
        "path": Path(path),
        "id": Path(path).name.split("-", 1)[0],
        "slug": Path(path).stem,
        "title": title,
        "blocks": blocks,
        "prose": {k: "\n".join(v).strip() for k, v in prose.items()},
        "base": base,
    }


def list_scenarios():
    return sorted(p for p in SCENARIOS_DIR.glob("[0-9][0-9]-*.md"))


# ---------------------------------------------------------------- structural tier


class Report:
    def __init__(self, quiet):
        self.quiet = quiet
        self.fails = 0
        self.warns = 0
        self.oks = 0

    def ok(self, msg):
        self.oks += 1
        if not self.quiet:
            print("  ok    " + msg)

    def warn(self, msg):
        self.warns += 1
        print("  warn  " + msg)

    def fail(self, msg):
        self.fails += 1
        print("  FAIL  " + msg)


def installed_skill_names():
    names = set()
    for d in (SKILLS_DIR, HOME / ".omp" / "agent" / "skills", HOME / ".agents" / "skills"):
        if d.is_dir():
            for p in d.iterdir():
                if (p / "SKILL.md").exists():
                    names.add(p.name)
    return names


def skill_text_files(skill_dir):
    return sorted(p for p in skill_dir.rglob("*.md") if p.is_file())


SKILL_URL_RE = re.compile(r"skill://([A-Za-z0-9][A-Za-z0-9_-]*)((?:/[A-Za-z0-9_.\-/*<>]*)?)")
BACKTICK_FACTORY_RE = re.compile(r"`(factory-[a-z][a-z0-9-]*)(?:[.`/ ][^`]*)?`")


def structural(args):
    rep = Report(args.quiet)
    allow_missing = args.allow_missing

    def missing(msg):
        (rep.warn if allow_missing else rep.fail)(msg)

    print("== skills")
    skill_dirs = sorted(p for p in SKILLS_DIR.iterdir()
                        if (p.name.startswith("factory") or p.name in EXPECTED_SKILLS)
                        and (p / "SKILL.md").exists())
    repo_skills = {p.name for p in skill_dirs}
    for name in EXPECTED_SKILLS:
        if name not in repo_skills:
            missing("skills/%s/SKILL.md is missing" % name)
    for d in skill_dirs:
        text = (d / "SKILL.md").read_text()
        fm, body_at = parse_frontmatter(text)
        label = "skills/%s" % d.name
        if fm is None:
            rep.fail("%s: no frontmatter" % label)
            continue
        if fm.get("name") != d.name:
            rep.fail("%s: name %r does not match directory" % (label, fm.get("name")))
        else:
            rep.ok("%s: name matches" % label)
        if not fm.get("description"):
            rep.fail("%s: description missing or empty" % label)
        elif "use when" not in fm["description"].lower():
            rep.warn("%s: description has no 'Use when' clause" % label)
        if d.name in DISABLE_MODEL_INVOCATION and fm.get("disable-model-invocation") != "true":
            rep.fail("%s: disable-model-invocation: true is required" % label)
        n = len(text.split("\n"))
        if n > SKILL_MAX_LINES:
            rep.warn("%s: SKILL.md is %d lines (house style: under ~%d)" % (label, n, SKILL_MAX_LINES))

    print("== agents")
    agent_files = sorted(AGENTS_DIR.glob("factory-*.md"))
    repo_agents = {p.stem for p in agent_files}
    for name in EXPECTED_AGENTS:
        if name not in repo_agents:
            missing("omp/agents/%s.md is missing" % name)
    installed = installed_skill_names()
    for f in agent_files:
        label = "omp/agents/%s" % f.name
        fm, _ = parse_frontmatter(f.read_text())
        if fm is None:
            rep.fail("%s: no frontmatter" % label)
            continue
        if fm.get("name") != f.stem:
            rep.fail("%s: name %r does not match file name" % (label, fm.get("name")))
        else:
            rep.ok("%s: name matches" % label)
        for key in ("description", "model"):
            if not fm.get(key):
                rep.fail("%s: %s missing or empty" % (label, key))
        if not fm.get("tools"):
            rep.warn("%s: no tools list (the agent gets every tool)" % label)
        for key in FORBIDDEN_AGENT_KEYS & set(fm):
            rep.fail("%s: `%s` is not allowed (contract: no structured/output schemas)" % (label, key))
        for s in [x.strip() for x in fm.get("autoloadSkills", "").split(",") if x.strip()]:
            if s in installed or s in repo_skills:
                rep.ok("%s: autoloadSkills %s exists" % (label, s))
            elif s in THIRD_PARTY_SKILLS:
                rep.warn("%s: autoloadSkills %s is third-party and not installed yet" % (label, s))
            else:
                rep.fail("%s: autoloadSkills %s does not exist (repo skills or ~/.omp/agent/skills)" % (label, s))

    print("== references")
    known_skills = installed | repo_skills
    texts = []
    for d in skill_dirs:
        texts.extend(skill_text_files(d))
    texts.extend(agent_files)
    bad = 0
    for f in texts:
        rel = f.relative_to(ROOT)
        content = f.read_text()
        for m in SKILL_URL_RE.finditer(content):
            name, sub = m.group(1), m.group(2).rstrip("./,")
            if name.endswith("-") and content[m.end(1):m.end(1) + 1] == "<":
                continue  # placeholder such as skill://verify-<app>
            if name not in known_skills:
                if name in THIRD_PARTY_SKILLS:
                    rep.warn("%s: skill://%s (third-party, not installed)" % (rel, name))
                else:
                    rep.fail("%s: skill://%s does not exist" % (rel, name))
                    bad += 1
                continue
            if sub and name in repo_skills and not re.search(r"[<>*]", sub):
                target = SKILLS_DIR / name / sub.lstrip("/")
                if not target.exists():
                    rep.fail("%s: skill://%s%s does not exist" % (rel, name, sub))
                    bad += 1
        for m in BACKTICK_FACTORY_RE.finditer(content):
            tok = m.group(1)
            if tok in repo_agents or tok in known_skills or tok in NON_AGENT_TOKENS:
                continue
            if tok in EXPECTED_AGENTS or tok in EXPECTED_SKILLS:
                missing("%s: `%s` is referenced and not written yet" % (rel, tok))
            else:
                rep.fail("%s: `%s` is neither a factory skill nor agent" % (rel, tok))
            bad += 1
    if not bad:
        rep.ok("all skill:// links and factory-* names resolve (%d files)" % len(texts))

    print("== files")
    for rel, must_exec in EXPECTED_FILES:
        p = ROOT / rel
        if not p.exists():
            missing("%s is missing" % rel)
        elif must_exec and not os.access(str(p), os.X_OK):
            rep.fail("%s is not executable" % rel)
        else:
            rep.ok(rel)
    for rel in ("skills/factory/scripts/factory-state", "omp/factory-evals/run"):
        p = ROOT / rel
        if p.exists() and open(str(p)).readline().startswith("#!/usr/bin/env python3"):
            try:
                with tempfile.TemporaryDirectory() as td:
                    py_compile.compile(str(p), cfile=os.path.join(td, "x.pyc"), doraise=True)
                rep.ok("%s compiles" % rel)
            except py_compile.PyCompileError as e:
                rep.fail("%s does not compile: %s" % (rel, e))

    print("== scenarios")
    files = list_scenarios()
    if not files:
        rep.fail("no scenarios in %s" % SCENARIOS_DIR)
    ids = set()
    for f in files:
        sc = parse_scenario(f)
        label = "scenarios/%s" % f.name
        if sc["id"] in ids:
            rep.fail("%s: duplicate scenario number" % label)
        ids.add(sc["id"])
        for sec in ("setup", "prompt", "expected", "rubric"):
            if not sc["prose"].get(sec) and not (sec == "prompt" and any(b[0] == "prompt" for b in sc["blocks"])):
                rep.fail("%s: section '%s' missing or empty" % (label, sec))
        if not any(b[0] == "prompt" for b in sc["blocks"]):
            rep.fail("%s: no ```prompt block" % label)
        if sc["base"] and not (BASE_DIR / sc["base"]).is_dir():
            rep.fail("%s: base %r not found in scenarios/_base" % (label, sc["base"]))
        for kind, attrs, _ in sc["blocks"]:
            if kind == "file" and "path" not in attrs:
                rep.fail("%s: file block without path=" % label)
            if kind == "sh" and not (attrs.get("setup") or attrs.get("check")):
                rep.fail("%s: sh block must be 'setup' or 'check'" % label)
            if kind not in ("file", "sh", "prompt", "json", "md", "text", ""):
                rep.warn("%s: unknown block kind %r" % (label, kind))
    rep.ok("%d scenario files parsed" % len(files))
    print("\nstructural: %d ok, %d warnings, %d FAILED" % (rep.oks, rep.warns, rep.fails))
    return 1 if rep.fails else 0


# ---------------------------------------------------------------- fixture


def sh(cmd, cwd, env, timeout=300):
    return subprocess.run(
        ["bash", "-euo", "pipefail", "-c", cmd], cwd=str(cwd), env=env,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True, timeout=timeout,
    )


class Fixture:
    def __init__(self, scenario):
        self.scenario = scenario
        self.tmp = Path(os.path.realpath(tempfile.mkdtemp(prefix="factory-eval-")))
        self.repo_name = "evalrepo-%s-%s" % (scenario["id"], self.tmp.name.split("-")[-1])
        self.repo = self.tmp / self.repo_name
        self.home_dirs = []
        self.env = None

    def subst(self, s):
        return s.replace("{repo}", self.repo_name)

    def target(self, path):
        path = self.subst(path)
        if path.startswith("@bin/"):
            return self.tmp / "bin" / path[5:]
        if path.startswith("@gh/"):
            return self.tmp / "gh-data" / path[4:]
        if path.startswith("@home/"):
            p = HOME / path[6:]
            m = re.match(r"^\.omp/factory/([^/]+)/", path[6:])
            if m:
                root = HOME / ".omp" / "factory" / m.group(1)
                if root not in self.home_dirs:
                    self.home_dirs.append(root)
            return p
        return self.repo / path

    def build(self):
        sc = self.scenario
        self.repo.mkdir(parents=True)
        (self.tmp / "bin").mkdir()
        (self.tmp / "gh-data").mkdir()
        env = dict(os.environ)
        env.update({
            "EVAL_TMP": str(self.tmp), "EVAL_REPO": str(self.repo),
            "EVAL_ORIGIN": str(self.tmp / "origin.git"), "EVAL_BASE": str(BASE_DIR),
            "EVAL_FS": str(STATE_TOOL), "EVAL_GH_DATA": str(self.tmp / "gh-data"),
            "EVAL_GH_LOG": str(self.tmp / "gh.log"),
            "PATH": str(self.tmp / "bin") + os.pathsep + os.environ.get("PATH", ""),
            "GIT_AUTHOR_NAME": "Factory Eval", "GIT_AUTHOR_EMAIL": "eval@example.invalid",
            "GIT_COMMITTER_NAME": "Factory Eval", "GIT_COMMITTER_EMAIL": "eval@example.invalid",
        })
        self.env = env
        sh("git init -q && git symbolic-ref HEAD refs/heads/main && "
           "git config user.name 'Factory Eval' && git config user.email eval@example.invalid && "
           "printf '.factory/\\nqa-evidence/\\n' >> .git/info/exclude", self.repo, env)
        if sc["base"]:
            shutil.copytree(str(BASE_DIR / sc["base"]), str(self.repo), dirs_exist_ok=True)
        uses_gh = False
        for kind, attrs, content in sc["blocks"]:
            if kind != "file":
                continue
            dest = self.target(attrs["path"])
            if attrs["path"].startswith("@gh/"):
                uses_gh = True
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(content)
            if "mode" in attrs:
                dest.chmod(int(attrs["mode"], 8))
        if uses_gh:
            gh = self.tmp / "bin" / "gh"
            gh.write_text(GH_STUB)
            gh.chmod(0o755)
        for kind, attrs, content in sc["blocks"]:
            if kind == "sh" and attrs.get("setup"):
                r = sh(self.subst(content), self.repo, env)
                if r.returncode != 0:
                    raise RuntimeError("setup failed (exit %d):\n%s" % (r.returncode, r.stdout))
        return self

    def uses_gh(self):
        return (self.tmp / "bin" / "gh").exists()

    def check(self, transcript_path):
        """Run the optional `sh check` blocks. Returns (ok or None, output)."""
        checks = [c for k, a, c in self.scenario["blocks"] if k == "sh" and a.get("check")]
        if not checks:
            return None, ""
        env = dict(self.env)
        env["EVAL_TRANSCRIPT"] = str(transcript_path)
        out, ok = [], True
        for c in checks:
            try:
                r = sh(self.subst(c), self.repo, env, timeout=120)
                out.append(r.stdout)
                ok = ok and r.returncode == 0
            except subprocess.TimeoutExpired:
                out.append("check timed out")
                ok = False
        return ok, "\n".join(out)

    def final_state(self):
        env = self.env

        def run(cmd):
            try:
                r = subprocess.run(cmd, shell=True, cwd=str(self.repo), env=env, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, universal_newlines=True, timeout=60)
                return r.stdout.strip()
            except Exception as e:  # noqa: BLE001
                return "(error: %s)" % e
        parts = [
            ("git status --short", run("git status --short")),
            ("git branch -a", run("git branch -a")),
            ("git log --oneline --all -n 20", run("git log --oneline --all -n 20")),
            ("git stash list", run("git stash list")),
            ("git diff --stat HEAD", run("git diff --stat HEAD")),
            (".factory/state.json", run("cat .factory/state.json 2>/dev/null")),
            (".factory/ledger.tsv", run("cat .factory/ledger.tsv 2>/dev/null")),
            ("ls .factory/feature", run("ls .factory/feature 2>/dev/null")),
            ("origin refs", run("git --git-dir=%s log --oneline --all -n 12 2>/dev/null" % self.env["EVAL_ORIGIN"])),
        ]
        glog = self.tmp / "gh.log"
        parts.append(("gh.log (stub calls)", glog.read_text().strip() if glog.exists() else "(none)"))
        return "\n\n".join("--- %s ---\n%s" % (k, v) for k, v in parts if v or k == "gh.log (stub calls)")

    def cleanup(self):
        for d in self.home_dirs:
            shutil.rmtree(str(d), ignore_errors=True)
        shutil.rmtree(str(self.tmp), ignore_errors=True)


# ---------------------------------------------------------------- running omp


def skill_prompt(prompt):
    """Print mode does not expand /skill:<name>; tell the agent to read the skill, as the TUI would."""
    first, _, rest = prompt.strip().partition("\n")
    m = re.match(r"^/skill:(\S+)\s*(.*)$", first)
    if not m:
        return prompt.strip()
    name, argtext = m.group(1), m.group(2)
    out = ("The user invoked the skill command `/skill:%s`. Skill commands are not expanded in this "
           "mode: read `skill://%s` with the read tool now and follow it as the user's invocation." % (name, name))
    if argtext:
        out += "\nUser arguments: %s" % argtext
    if rest.strip():
        out += "\nUser: %s" % rest.strip()
    return out


def parse_duration(s):
    m = re.match(r"^(\d+)([smh]?)$", s)
    if not m:
        raise argparse.ArgumentTypeError("use 600, 10m or 1h")
    return int(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600}[m.group(2)]


def run_omp(prompt, cwd, env, out_dir, args, max_time):
    out_dir.mkdir(parents=True, exist_ok=True)
    cmd = ["omp", "-p", "--mode", "json", "--no-title", "--session-dir", str(out_dir / "sessions"),
           "--max-time", str(max_time)]
    if args.model:
        cmd += ["--model", args.model]
    for c in args.config or []:
        cmd += ["--config", c]
    cmd.append(prompt)
    started = time.time()
    try:
        r = subprocess.run(cmd, cwd=str(cwd), env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           universal_newlines=True, timeout=max_time + 120)
        stdout, stderr, code = r.stdout, r.stderr, r.returncode
    except subprocess.TimeoutExpired as e:
        stdout = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
        stderr = "timeout"
        code = 124
    (out_dir / "transcript.jsonl").write_text(stdout)
    (out_dir / "stderr.txt").write_text(stderr or "")
    return code, time.time() - started


def trunc(s, n):
    s = s if isinstance(s, str) else json.dumps(s)
    return s if len(s) <= n else s[:n] + " …[%d chars cut]" % (len(s) - n)


def result_text(res):
    if isinstance(res, dict):
        c = res.get("content")
        if isinstance(c, list):
            return "".join(p.get("text", "") for p in c if isinstance(p, dict))
    return json.dumps(res)


def digest(transcript_path, limit=70000):
    """Readable summary of the JSON event stream: tool calls, results, assistant text."""
    lines = []
    for raw in Path(transcript_path).read_text().split("\n"):
        if not raw.strip():
            continue
        try:
            ev = json.loads(raw)
        except ValueError:
            continue
        t = ev.get("type")
        if t == "tool_execution_start":
            lines.append("TOOL %s %s" % (ev.get("toolName"), trunc(ev.get("args"), 900)))
        elif t == "tool_execution_end":
            tag = "ERROR" if ev.get("isError") else "RESULT"
            lines.append("  %s %s" % (tag, trunc(result_text(ev.get("result")), 1200)))
        elif t == "message_end":
            msg = ev.get("message", {})
            if msg.get("role") == "assistant":
                text = "".join(p.get("text", "") for p in msg.get("content", [])
                               if isinstance(p, dict) and p.get("type") == "text")
                if text.strip():
                    lines.append("ASSISTANT: " + trunc(text, 3000))
    out = "\n".join(lines)
    if len(out) > limit:  # keep the start and the end
        out = out[: limit // 2] + "\n…[middle cut]…\n" + out[-limit // 2:]
    return out


def tool_reads(transcript_path):
    """Return the text of every read-tool path in the transcript (for routing checks)."""
    seen = []
    for raw in Path(transcript_path).read_text().split("\n"):
        try:
            ev = json.loads(raw)
        except ValueError:
            continue
        if ev.get("type") == "tool_execution_start":
            seen.append("%s %s" % (ev.get("toolName"), json.dumps(ev.get("args"))))
    return seen


def pick_judge(args):
    if args.judge_model:
        return args.judge_model
    under_test = (args.model or "").lower()
    if any(k in under_test for k in ("gpt", "openai", "codex")):
        return DEFAULT_JUDGE_FOR_GPT
    return DEFAULT_JUDGE


JUDGE_TEMPLATE = """You are grading one run of an automated software-engineering agent against a fixed scenario.
Judge only what the transcript and the final repository state show; ignore the agent's own claims of success.
Be strict: the rubric says what passes and what fails.

# Scenario
{title}

# What was sent to the agent
{prompt}

# What should happen
{expected}

# Rubric
{rubric}

# Deterministic check (exit status decided by a script; FAIL here means the run fails)
{check}

# Final repository state
{state}

# Transcript digest (tool calls, results, assistant text; long values are cut)
{digest}

# Answer
Write at most 12 lines of reasons that cite specific transcript lines or repo facts. Then, as the very last line, write exactly one of:
VERDICT: PASS
VERDICT: FAIL
"""


def judge(sc, fx, check_ok, check_out, digest_text, prompt, judge_model, out_dir, timeout=600):
    p = JUDGE_TEMPLATE.format(
        title=sc["title"], prompt=prompt, expected=sc["prose"].get("expected", ""),
        rubric=sc["prose"].get("rubric", ""),
        check=("none" if check_ok is None else "%s\n%s" % ("exit 0 (ok)" if check_ok else "NON-ZERO (failed)", check_out.strip())),
        state=fx.final_state(), digest=digest_text,
    )
    (out_dir / "judge-prompt.txt").write_text(p)
    cmd = ["omp", "-p", "--no-session", "--no-title", "--no-tools", "--no-skills", "--no-extensions",
           "--no-rules", "--model", judge_model]
    try:
        r = subprocess.run(cmd, input=p, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           universal_newlines=True, timeout=timeout)
        text = r.stdout
    except subprocess.TimeoutExpired:
        text = "judge timed out\nVERDICT: FAIL"
    (out_dir / "judge.txt").write_text(text)
    m = re.findall(r"VERDICT:\s*(PASS|FAIL)", text)
    return (m[-1] == "PASS") if m else None


# ---------------------------------------------------------------- gate-hold tier


def one_gate_run(sc_path, run_no, out_root, args, judge_model, max_time):
    sc = parse_scenario(sc_path)
    out_dir = out_root / sc["slug"] / ("run-%d" % run_no)
    fx = Fixture(sc)
    try:
        fx.build()
    except Exception as e:  # noqa: BLE001
        out_dir.mkdir(parents=True, exist_ok=True)
        (out_dir / "setup-error.txt").write_text(str(e))
        fx.cleanup()
        return {"scenario": sc["slug"], "run": run_no, "pass": False, "why": "fixture setup failed", "dir": str(out_dir)}
    try:
        prompt_block = next(c for k, a, c in sc["blocks"] if k == "prompt")
        prompt = fx.subst(prompt_block.strip())
        sent = skill_prompt(prompt) + HARNESS_NOTE
        if fx.uses_gh():
            sent += ("\n[Harness note: GitHub is unreachable here. `gh` on PATH is a local stub that serves "
                     "recorded answers and logs calls.]")
        if args.dry_run:
            print("[dry-run] %s run %d: fixture at %s" % (sc["slug"], run_no, fx.repo))
            print(fx.final_state())
            for d in fx.home_dirs:  # the repo is kept; holdout files under $HOME are not
                shutil.rmtree(str(d), ignore_errors=True)
            return {"scenario": sc["slug"], "run": run_no, "pass": None, "why": "dry run", "dir": str(fx.repo)}
        code, secs = run_omp(sent, fx.repo, fx.env, out_dir, args, max_time)
        transcript = out_dir / "transcript.jsonl"
        dg = digest(transcript)
        (out_dir / "digest.txt").write_text(dg)
        check_ok, check_out = fx.check(transcript)
        (out_dir / "check.txt").write_text(check_out)
        (out_dir / "final-state.txt").write_text(fx.final_state())
        verdict = None if args.no_judge else judge(sc, fx, check_ok, check_out, dg, sent, judge_model, out_dir)
        if args.no_judge:
            passed, why = (check_ok if check_ok is not None else None), "no judge"
        elif verdict is None:
            passed, why = False, "judge gave no verdict"
        else:
            passed = verdict and (check_ok is None or check_ok)
            why = "judge %s%s" % ("PASS" if verdict else "FAIL",
                                  "" if check_ok is None else ", check %s" % ("ok" if check_ok else "FAILED"))
        res = {"scenario": sc["slug"], "run": run_no, "pass": passed, "why": why, "exit": code,
               "seconds": round(secs), "dir": str(out_dir)}
        (out_dir / "result.json").write_text(json.dumps(res, indent=2))
        return res
    finally:
        if not (args.keep or args.dry_run):
            fx.cleanup()


def select_scenarios(wanted):
    files = list_scenarios()
    if not wanted:
        return files
    chosen = []
    for w in wanted:
        key = w.zfill(2) if w.isdigit() else w
        hit = [f for f in files if f.name.startswith(key + "-") or f.stem == key or key in f.stem]
        if not hit:
            sys.exit("no scenario matches %r (try `run gate-hold --list`)" % w)
        chosen.extend(h for h in hit if h not in chosen)
    return chosen


def summarize(results, label):
    by = {}
    for r in results:
        by.setdefault(r["scenario"], []).append(r)
    print("\n%-44s %-8s %s" % (label, "pass", "rate"))
    worst = 1.0
    for name in sorted(by):
        rs = by[name]
        done = [r for r in rs if r["pass"] is not None]
        n_pass = sum(1 for r in done if r["pass"])
        rate = (n_pass / len(done)) if done else 0.0
        worst = min(worst, rate) if done else worst
        print("%-44s %d/%-6d %3d%%" % (name, n_pass, len(done), round(rate * 100)))
        for r in rs:
            if r["pass"] is False:
                print("    run %d failed: %s (%s)" % (r["run"], r["why"], r["dir"]))
    return worst


def make_out_root(args, tier):
    if args.out:
        root = Path(args.out).expanduser()
    else:
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        root = HOME / ".local" / "share" / "factory-evals" / ("%s-%s" % (tier, stamp))
    root.mkdir(parents=True, exist_ok=True)
    return root


def gate_hold(args):
    if args.list:
        for f in list_scenarios():
            print("%s  %s" % (f.stem, parse_scenario(f)["title"]))
        return 0
    files = select_scenarios(args.scenario)
    runs = 1 if args.dry_run else args.runs
    judge_model = pick_judge(args)
    out_root = make_out_root(args, "gate-hold")
    print("gate-hold: %d scenario(s) x %d run(s); agent model %s; judge %s; transcripts in %s" % (
        len(files), runs, args.model or "(default)", "none" if args.no_judge else judge_model, out_root))
    jobs = [(f, i + 1) for f in files for i in range(runs)]
    results = []
    with cf.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as ex:
        futs = [ex.submit(one_gate_run, f, i, out_root, args, judge_model, args.max_time) for f, i in jobs]
        for fut in cf.as_completed(futs):
            r = fut.result()
            results.append(r)
            print("  %s run %d: %s" % (r["scenario"], r["run"], "pass" if r["pass"] else ("n/a" if r["pass"] is None else "FAIL")), flush=True)
    if args.dry_run:
        return 0
    worst = summarize(results, "scenario")
    return 0 if worst >= args.min_pass else 1


# ---------------------------------------------------------------- routing tier


def one_routing_run(case, run_no, out_root, args, max_time):
    cid, prompt, must, must_not = case
    tmp = Path(os.path.realpath(tempfile.mkdtemp(prefix="factory-route-")))
    repo = tmp / ("routerepo-%s" % cid)
    repo.mkdir()
    env = dict(os.environ)
    env.update({"GIT_AUTHOR_NAME": "Factory Eval", "GIT_AUTHOR_EMAIL": "eval@example.invalid",
                "GIT_COMMITTER_NAME": "Factory Eval", "GIT_COMMITTER_EMAIL": "eval@example.invalid"})
    out_dir = out_root / ("routing-%s" % cid) / ("run-%d" % run_no)
    try:
        subprocess.run("git init -q && printf '# demo\\n\\nWe recieve data here.\\n' > README.md && git add -A && git commit -qm init",
                       shell=True, cwd=str(repo), env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sent = skill_prompt(prompt) + HARNESS_NOTE
        code, secs = run_omp(sent, repo, env, out_dir, args, max_time)
        reads = "\n".join(tool_reads(out_dir / "transcript.jsonl"))

        def read(name):
            return re.search(r"skill://%s(?![A-Za-z0-9-])" % re.escape(name), reads) or \
                re.search(r"skills/%s/SKILL\.md" % re.escape(name), reads)
        miss = [n for n in must if not read(n)]
        wrong = [n for n in must_not if read(n)]
        why = "ok" if not (miss or wrong) else "; ".join(
            (["did not read " + ", ".join(miss)] if miss else []) + (["read forbidden " + ", ".join(wrong)] if wrong else []))
        return {"scenario": "routing-" + cid, "run": run_no, "pass": not (miss or wrong), "why": why,
                "dir": str(out_dir), "exit": code, "seconds": round(secs)}
    finally:
        if not args.keep:
            shutil.rmtree(str(tmp), ignore_errors=True)


def routing(args):
    cases = ROUTING_CASES
    if args.list:
        for cid, prompt, must, must_not in cases:
            print("%s  %s  read=%s forbid=%s" % (cid, prompt, must or "-", len(must_not)))
        return 0
    if args.scenario:
        want = {w.upper() for w in args.scenario}
        cases = [c for c in cases if c[0] in want]
        if not cases:
            sys.exit("no routing case matches %s" % sorted(want))
    out_root = make_out_root(args, "routing")
    print("routing: %d case(s) x %d run(s); transcripts in %s" % (len(cases), args.runs, out_root))
    jobs = [(c, i + 1) for c in cases for i in range(args.runs)]
    results = []
    with cf.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as ex:
        futs = [ex.submit(one_routing_run, c, i, out_root, args, args.max_time) for c, i in jobs]
        for fut in cf.as_completed(futs):
            r = fut.result()
            results.append(r)
            print("  %s run %d: %s" % (r["scenario"], r["run"], "pass" if r["pass"] else "FAIL (%s)" % r["why"]), flush=True)
    worst = summarize(results, "case")
    return 0 if worst >= args.min_pass else 1


# ---------------------------------------------------------------- main


def build_parser():
    ap = argparse.ArgumentParser(
        prog="run",
        description="Factory evals. Tiers: structural (offline, fast), routing (skill selection), "
                    "gate-hold (one planted fault per gate, graded by a judge from another model family).",
    )
    sub = ap.add_subparsers(dest="tier", metavar="TIER")
    sub.required = True

    s = sub.add_parser("structural", help="frontmatter, name/reference resolution, scenario files; offline")
    s.add_argument("-q", "--quiet", action="store_true", help="print only warnings and failures")
    s.add_argument("--allow-missing", action="store_true",
                   help="treat not-yet-written skills, agents and files as warnings (use while slices are landing)")
    s.set_defaults(fn=structural)

    def model_opts(p, runs, max_time):
        p.add_argument("--scenario", action="append", metavar="ID", help="case id or number, repeatable (default: all)")
        p.add_argument("--runs", type=int, default=runs, help="runs per case (default %d)" % runs)
        p.add_argument("--model", help="model for the agent under test (passed to omp --model)")
        p.add_argument("--config", action="append", metavar="FILE", help="extra omp --config overlay, repeatable")
        p.add_argument("--max-time", type=parse_duration, default=max_time,
                       help="per-run limit, e.g. 600, 10m (default %ds)" % max_time)
        p.add_argument("--jobs", type=int, default=1, help="runs in parallel (default 1)")
        p.add_argument("--out", help="directory for transcripts (default ~/.local/share/factory-evals/<tier>-<time>)")
        p.add_argument("--keep", action="store_true", help="keep the temp repos")
        p.add_argument("--min-pass", type=float, default=0.8, metavar="RATE",
                       help="exit 1 if any case's pass rate is below this (default 0.8)")
        p.add_argument("--list", action="store_true", help="list cases and exit")

    r = sub.add_parser("routing", help="does omp read the right skill (or none) for a prompt; no judge")
    model_opts(r, 3, 180)
    r.set_defaults(fn=routing)

    g = sub.add_parser("gate-hold", help="plant one fault in a throwaway repo, run omp -p --mode json, judge the result")
    model_opts(g, 5, 900)
    g.add_argument("--judge-model", help="judge model (default %s; %s when the agent under test is GPT)" % (
        DEFAULT_JUDGE, DEFAULT_JUDGE_FOR_GPT))
    g.add_argument("--no-judge", action="store_true", help="skip the judge; pass/fail from the deterministic check only")
    g.add_argument("--dry-run", action="store_true", help="build the fixture, print its state, do not run omp (keeps the repo)")
    g.set_defaults(fn=gate_hold)
    return ap


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
