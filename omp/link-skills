#!/usr/bin/env bash
# Link this repo's OMP skills, task agents, rules and extensions into the user
# OMP directories.
set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
skills_src="$root/skills"
agents_src="$root/agents"
skills_dest="$HOME/.omp/agent/skills"
agents_dest="$HOME/.omp/agent/agents"
rules_src="$root/rules"
rules_dest="$HOME/.omp/agent/rules"
extensions_src="$root/extensions"
extensions_dest="$HOME/.omp/agent/extensions"

check_dest() {
  local src=$1 dest=$2 item link
  for item in "$src"/*/; do
    [[ -f $item/SKILL.md ]] || continue
    link="$dest/$(basename "$item")"
    if [[ -e $link || -L $link ]]; then
      if [[ ! -L $link ]] || [[ $(readlink "$link") != "$src"/* ]]; then
        echo "Refusing to replace existing item: $link" >&2
        exit 1
      fi
    fi
  done
}

# $3 is the file extension to link: md for agents and rules, ts for extensions.
check_files() {
  local src=$1 dest=$2 ext=$3 item link
  for item in "$src"/*."$ext"; do
    [[ -f $item ]] || continue
    link="$dest/$(basename "$item")"
    if [[ -e $link || -L $link ]]; then
      if [[ ! -L $link ]] || [[ $(readlink "$link") != "$src"/* ]]; then
        echo "Refusing to replace existing item: $link" >&2
        exit 1
      fi
    fi
  done
}

link_files() {
  local src=$1 dest=$2 ext=$3 item link
  for link in "$dest"/*."$ext"; do
    if [[ -L $link && $(readlink "$link") == "$src"/* && ! -e $link ]]; then
      rm "$link"
    fi
  done
  for item in "$src"/*."$ext"; do
    [[ -f $item ]] || continue
    ln -sfn "$item" "$dest/$(basename "$item")"
  done
}

check_dest "$skills_src" "$skills_dest"
check_files "$agents_src" "$agents_dest" md
check_files "$rules_src" "$rules_dest" md
check_files "$extensions_src" "$extensions_dest" ts
mkdir -p "$skills_dest" "$agents_dest" "$rules_dest" "$extensions_dest"

for link in "$skills_dest"/*; do
  if [[ -L $link && $(readlink "$link") == "$skills_src"/* && ! -e $link ]]; then
    rm "$link"
  fi
done
for item in "$skills_src"/*/; do
  [[ -f $item/SKILL.md ]] || continue
  ln -sfn "${item%/}" "$skills_dest/$(basename "$item")"
done

link_files "$agents_src" "$agents_dest" md
link_files "$rules_src" "$rules_dest" md
link_files "$extensions_src" "$extensions_dest" ts
