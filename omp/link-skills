#!/usr/bin/env bash
# Links every omp/skills/<name> into Oh My Pi's skill directory,
# ~/.omp/agent/skills, and every omp/agents/<name>.md into its agent
# directory, ~/.omp/agent/agents. Run it again after adding or removing one;
# links left pointing at a removed one are pruned. Refuses to replace any other
# skill or agent of the same name.
set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
omp=${1:-"$HOME/.omp/agent"}

skills=()
for skill in "$root"/skills/*/; do
  [[ -f $skill/SKILL.md ]] && skills+=("${skill%/}")
done
agents=("$root"/agents/*.md)
[[ -e ${agents[0]} ]] || agents=()

# link <dest dir> <source items...>: one link per item, by basename.
link() {
  local dest=$1 item target
  shift
  for item in "$@"; do
    target="$dest/$(basename "$item")"
    if [[ -e $target || -L $target ]]; then
      if [[ ! -L $target ]] || [[ $(readlink "$target") != "$root"/* ]]; then
        echo "Refusing to replace existing entry: $target" >&2
        exit 1
      fi
    fi
  done
  mkdir -p "$dest"
  for target in "$dest"/*; do
    if [[ -L $target && $(readlink "$target") == "$root"/* && ! -e $target ]]; then
      rm "$target"
    fi
  done
  for item in "$@"; do
    ln -sfn "$item" "$dest/$(basename "$item")"
  done
}

link "$omp/skills" ${skills[@]+"${skills[@]}"}
link "$omp/agents" ${agents[@]+"${agents[@]}"}
