# eza — the good-looking ls: icons, directories first, git state in long mode.
if (( $+commands[eza] )); then
  _pk_eza=(eza --icons=auto --group-directories-first --color=auto
           --color-scale=size --hyperlink)
  alias ls="${_pk_eza[*]}"
  alias l="${_pk_eza[*]} --long --header --git --no-user --time-style=relative"
  alias ll="${_pk_eza[*]} --long --header --git --time-style=long-iso"
  alias la="${_pk_eza[*]} --long --header --git --all --time-style=long-iso"
  alias lt="${_pk_eza[*]} --tree --level=2 --git-ignore"
  alias lta="${_pk_eza[*]} --tree --level=3 --all"
  alias lS="${_pk_eza[*]} --long --header --all --sort=size --reverse"
  alias lm="${_pk_eza[*]} --long --header --all --sort=modified --reverse"
  unset _pk_eza
else
  alias ls='ls -G'
  alias l='ls -lh'
  alias ll='ls -lh'
  alias la='ls -lha'
fi

# bat — cat with syntax highlighting, and a readable man(1).
if (( $+commands[bat] )); then
  # `ansi` renders through the terminal's own 16 colours instead of shipping a
  # second palette, so bat inherits Pale Knight and can never drift from it.
  # TwoDark was a foreign, far more saturated set.
  export BAT_THEME=ansi
  export BAT_STYLE='numbers,changes,header'
  export MANPAGER="sh -c 'col -bx | bat --language=man --plain'"
  export MANROFFOPT='-c'
  alias cat='bat --paging=never'
  alias catp='bat --plain --paging=never'
fi

# zoxide — `z dotfiles` goes where you meant, `zi` picks from the ranked list.
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

(( $+commands[rg] )) && alias rg='rg --smart-case --hidden --glob=!.git'
(( $+commands[fd] )) && alias fd='fd --hidden --follow --exclude=.git'

# nvm — node is on PATH, nvm itself is not loaded until it is called.
# `. nvm.sh` costs ~0.85s, which no prompt should pay, and its own startup
# `nvm use default` currently resolves to nothing anyway (the default alias
# chains default → node → stable, and stable has no local match). So the
# newest installed version goes straight on PATH, and the shim below sources
# nvm.sh on the first `nvm` call and hands the arguments over.
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  _pk_node=("$NVM_DIR"/versions/node/*/bin(Nn[-1]))
  (( $#_pk_node )) && path=("$_pk_node[1]" $path)
  unset _pk_node

  nvm() {
    unfunction nvm
    source "$NVM_DIR/nvm.sh"
    nvm "$@"
  }
fi


