# tn [name] [path] — create or attach a named session rooted at a directory.
# Name defaults to the directory's basename, path to $PWD. -A attaches to an
# existing session of that name instead of failing; from inside tmux the new
# session is made detached and switched to, since sessions cannot nest.
tn() {
  local dir=${2:-$PWD} name=$1
  dir=${dir:A}
  : ${name:=${dir:t}}
  if [[ -n $TMUX ]]; then
    tmux new-session -dA -s "$name" -c "$dir" && tmux switch-client -t "$name"
  else
    tmux new-session -A -s "$name" -c "$dir"
  fi
}

# mkcd — make it, then step into it.
mkcd() { mkdir -p -- "$1" && cd -- "$1" }

# up 3 — climb three directories.
up() {
  local n=${1:-1} p=''
  repeat $n p+='../'
  cd -- "${p:-.}"
}

# ff — fuzzy-find a file under here and open it.
ff() {
  local file
  file=$(fzf --preview 'pk-preview {}' --preview-window=right,60%) || return 0
  [[ -n $file ]] && ${=EDITOR} -- "$file"
  return 0
}


