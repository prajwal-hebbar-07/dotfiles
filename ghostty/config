# ─────────────────────────────────────────────────────────────────────────────
# Ghostty — Pale Knight
#
# Source of truth: dotfiles/ghostty/config  (~/.config/ghostty/config -> here)
# Reload in place: Cmd+Shift+, (reload_config)
#
# Note: Ghostty has no trailing comments. A `#` after a value is part of the
# value, so every comment here sits on its own line.
# ─────────────────────────────────────────────────────────────────────────────

# Colours live in themes/pale-knight, next to this file.
theme = pale-knight


# ── Fully opaque ─────────────────────────────────────────────────────────────
# Nothing behind the window may show through. Ghostty already defaults to an
# opaque background, so the desktop bleeding through came from the transparent
# macOS titlebar; `tabs` draws it in the theme background instead.
background-opacity = 1
background-blur = false
background-image =
macos-titlebar-style = tabs

# Unfocused splits keep full strength instead of fading to 0.7, so an inactive
# pane reads as solid rather than washed out.
unfocused-split-opacity = 1
unfocused-split-fill = #0f111a


# ── Type ─────────────────────────────────────────────────────────────────────
# JetBrains Mono, with Symbols Nerd Font Mono behind it for the glyphs the
# prompt and status bars use. Carried over from dotfiles-old; this config had
# no font settings at all, so Ghostty was falling back to the macOS default.
font-family = JetBrains Mono
font-family = Symbols Nerd Font Mono
font-size = 13
# Ligatures off: `->`, `!=` and `=>` stay as the characters they are.
font-feature = -calt
# Loosen the line box; box-drawing and separators still join because Ghostty
# stretches them to the cell.
adjust-cell-height = 12%
font-thicken = false


# ── Window ───────────────────────────────────────────────────────────────────
# Titlebar and chrome follow the theme instead of the macOS appearance.
window-theme = ghostty
window-padding-x = 10
# Roomier above, tighter below — the tmux status bar already occupies the last
# row, so it does not need padding under it.
window-padding-y = 10,5
window-padding-balance = true
# The palette is written in sRGB hex; render it unconverted.
window-colorspace = srgb


# ── Cursor ───────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true


# ── Terminal ─────────────────────────────────────────────────────────────────
# tmux keeps its own 50k history; this is for bare shells outside tmux.
scrollback-limit = 100000000
copy-on-select = clipboard
# tmux owns the session, so a closed window loses nothing.
confirm-close-surface = false
