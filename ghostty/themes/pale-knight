# Pale Knight — Ghostty theme
#
# Material Palenight, held down in chroma. Indigo-violet ground, Palenight's own
# foreground, soul-cyan for what is alive and focused, infection for what wants
# attention. Same palette as tmux/tmux.conf and zsh/zshrc.
#
# Selected from ghostty/config with `theme = pale-knight`. Ghostty reads custom
# themes from the `themes` subdirectory of its config directory.
#
# ── Surfaces are Palenight ───────────────────────────────────────────────────
# The ground is violet, not blue-grey: every surface sits on hue 278-286 in
# OKLCH, the hue band Palenight itself occupies, at Palenight's chroma rather
# than half of it. Three of the seven steps are Palenight's own colours.
#
#   background  #0f111a   L 0.180  C 0.020  H 278   (near-black, was #26283b)
#   crypt       #32334a   L 0.330  C 0.040  H 281
#   shade       #444364   L 0.398  C 0.055  H 286   (Palenight sel   #444267)
#   stone       #696e93   L 0.548  C 0.058  H 278   (Palenight comm. #676e95)
#   ash         #9297ba   L 0.685  C 0.052  H 278
#   foreground  #a6accd   L 0.751  C 0.048  H 277   (Palenight fg    #a6accd)
#   pale        #d4d7f1   L 0.885  C 0.035  H 280
#
# ── Accents keep the equal-weight rule ───────────────────────────────────────
# Palenight's hues, generated in OKLCH at one fixed lightness, so hue is the
# only thing that changes between them. Equal lightness means equal attention:
# six colours you can tell apart, none of which grabs the eye before the others.
#
#   ANSI 1-6    L = 0.72    contrast vs background 5.6-6.0:1
#   ANSI 9-14   L = 0.80    contrast vs background 7.5-8.0:1
#   chroma      0.095       (violet 0.105) — about 70% of Palenight's 0.13-0.16,
#               so the hue is unmistakable without the neon
#   hues        red 19  green 130  yellow 81  blue 264  violet 311  cyan 226
#               — Palenight's own, within a degree or two

# ── Surface ──────────────────────────────────────────────────────────────────
# Near-black ground: the old #26283b read pale in a lit room. Same violet hue,
# held down to L 0.18, so foreground on background is 8.4:1 instead of 6.5:1.
background = #0f111a
foreground = #a6accd

# Block cursor is the largest solid colour on screen, so it gets a normal-weight
# accent, not a bright one.
cursor-color = #5cb1d2
cursor-text  = #0f111a

selection-background = #444364
selection-foreground = #d4d7f1

# Find-in-terminal highlight: muted infection on void, matching the tmux message
# bar. Findable at a glance, no longer a flare.
search-background = #c39e5c
search-foreground = #0f111a

split-divider-color = #444364

# ── ANSI 0-7 ─────────────────────────────────────────────────────────────────
palette = 0=#32334a
palette = 1=#da8c8d
palette = 2=#91b171
palette = 3=#c39e5c
palette = 4=#86a4e1
palette = 5=#ba92d5
palette = 6=#5cb1d2
palette = 7=#a6accd

# ── ANSI 8-15 (bright) ───────────────────────────────────────────────────────
palette = 8=#696e93
palette = 9=#f5a5a6
palette = 10=#aaca89
palette = 11=#ddb875
palette = 12=#9fbdfc
palette = 13=#d3abf0
palette = 14=#76cbed
palette = 15=#d4d7f1
