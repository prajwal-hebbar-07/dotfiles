#!/usr/bin/env python3
"""board: every GitHub issue and Project write the factory makes.

Run from the target repo. Wraps `gh`; no agent writes gh issue/project calls
by hand. Native sub-issue / blocked-by flags are used on gh >= 2.94.0, REST
otherwise. Project ids are cached in .factory/board.json.

Exit codes: 0 ok, 1 the operation failed, 2 usage or environment error
(gh missing, not logged in, missing `project` scope, not in a git repo).
"""
import argparse
import json
import os
import re
import subprocess
import sys

NATIVE_MIN = (2, 94, 0)
STATUS_LABELS = [
    "factory:queued", "factory:building", "factory:review", "factory:qa",
    "factory:ui", "factory:pr-ready", "factory:needs-human",
]
OTHER_LABELS = ["sec:boundary", "ui"]
LABEL_COLORS = {
    "factory:queued": "ededed", "factory:building": "fbca04",
    "factory:review": "1d76db", "factory:qa": "5319e7",
    "factory:ui": "c5def5", "factory:pr-ready": "0e8a16",
    "factory:needs-human": "d93f0b", "sec:boundary": "b60205", "ui": "bfdadc",
}
# Status option names for the Project field, one per label.
OPTION_NAMES = {
    "factory:queued": "Queued", "factory:building": "Building",
    "factory:review": "Review", "factory:qa": "QA", "factory:ui": "UI",
    "factory:pr-ready": "PR ready", "factory:needs-human": "Needs human",
}
# Used only when the Status field cannot be given the options above.
COARSE = {
    "factory:queued": "Todo", "factory:building": "In Progress",
    "factory:review": "In Progress", "factory:qa": "In Progress",
    "factory:ui": "In Progress", "factory:pr-ready": "In Progress",
    "factory:needs-human": "In Progress",
}
DISCLAIMER = "> Generated by the factory."


class Fail(Exception):
    """Operation failed (exit 1)."""


class Env(Exception):
    """Environment or usage problem (exit 2)."""


def gh(args, stdin=None, check=True):
    try:
        p = subprocess.run(["gh"] + args, input=stdin, capture_output=True,
                           text=True)
    except FileNotFoundError:
        raise Env("gh is not installed")
    if check and p.returncode != 0:
        err = (p.stderr or p.stdout).strip()
        if "auth login" in err or "not logged" in err.lower():
            raise Env("gh is not logged in: run `gh auth login`")
        if "scope" in err and "project" in err:
            raise Env("missing the project scope: run `gh auth refresh -s project`")
        raise Fail("gh %s: %s" % (" ".join(args[:3]), err))
    return p


def gh_json(args, stdin=None):
    return json.loads(gh(args, stdin).stdout or "null")


def gh_version():
    out = gh(["--version"]).stdout
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", out)
    if not m:
        raise Env("cannot parse gh --version")
    return tuple(int(x) for x in m.groups())


def native():
    return gh_version() >= NATIVE_MIN


def repo_root():
    p = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    if p.returncode != 0:
        raise Env("not inside a git repository")
    return p.stdout.strip()


def cache_path():
    return os.path.join(repo_root(), ".factory", "board.json")


def load_cache():
    try:
        with open(cache_path()) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_cache(data):
    path = cache_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, path)


def repo_info():
    d = gh_json(["repo", "view", "--json", "owner,name"])
    return d["owner"]["login"], d["name"]


def read_body(path):
    if path == "-":
        return sys.stdin.read()
    try:
        with open(path) as f:
            return f.read()
    except OSError as e:
        raise Env("cannot read %s: %s" % (path, e))


def issue_id(n):
    return gh(["api", "repos/{owner}/{repo}/issues/%s" % n, "--jq", ".id"]).stdout.strip()


# ---------------------------------------------------------------- commands

def cmd_labels(a):
    for name in STATUS_LABELS + OTHER_LABELS:
        gh(["label", "create", name, "--force", "--color", LABEL_COLORS[name],
            "--description", "factory"])
        print("label " + name)


def marker_for(key):
    return "<!-- factory:issue=%s -->" % key


def find_by_marker(key):
    m = marker_for(key)
    issues = gh_json(["issue", "list", "--state", "all", "--limit", "1000",
                      "--json", "number,body"])
    for i in issues:
        if m in (i.get("body") or ""):
            return i["number"]
    return None


def cmd_create(a):
    key = a.key or re.sub(r"[^a-z0-9]+", "-", a.title.lower()).strip("-")
    existing = find_by_marker(key)
    if existing is not None:
        print(existing)
        return
    body = read_body(a.body_file)
    m = marker_for(key)
    if m not in body:
        body = body.rstrip("\n") + "\n\n" + m + "\n"
    args = ["issue", "create", "--title", a.title, "--body-file", "-"]
    for lab in a.label or []:
        args += ["--label", lab]
    url = gh(args, stdin=body).stdout.strip().splitlines()[-1]
    print(url.rstrip("/").rsplit("/", 1)[-1])


def already(p):
    t = (p.stderr + p.stdout).lower()
    return "already" in t or "duplicate" in t


def cmd_sub_issue(a):
    if native():
        p = gh(["issue", "edit", a.parent, "--add-sub-issue", a.child], check=False)
    else:
        p = gh(["api", "-X", "POST", "repos/{owner}/{repo}/issues/%s/sub_issues" % a.parent,
                "-F", "sub_issue_id=" + issue_id(a.child)], check=False)
    if p.returncode != 0 and not already(p):
        raise Fail("sub-issue: " + (p.stderr or p.stdout).strip())
    print("sub-issue #%s of #%s" % (a.child, a.parent))


def cmd_blocked_by(a):
    if native():
        p = gh(["issue", "edit", a.issue, "--add-blocked-by", a.blocker], check=False)
    else:
        p = gh(["api", "-X", "POST",
                "repos/{owner}/{repo}/issues/%s/dependencies/blocked_by" % a.issue,
                "-F", "issue_id=" + issue_id(a.blocker)], check=False)
    if p.returncode != 0 and not already(p):
        raise Fail("blocked-by: " + (p.stderr or p.stdout).strip())
    print("#%s blocked by #%s" % (a.issue, a.blocker))


def project_args(cache):
    return ["--owner", cache["owner"]]


def set_project_status(n, label, cache):
    """Set the Project Status field for issue n. Silent no-op without a board."""
    if not cache.get("projectId"):
        return
    item = cache.get("items", {}).get(str(n))
    if not item:
        item = add_item(n, cache)
    opt = cache["options"].get(label)
    if not opt:
        return
    gh(["project", "item-edit", "--id", item, "--project-id", cache["projectId"],
        "--field-id", cache["statusFieldId"], "--single-select-option-id", opt])


def cmd_status(a):
    if a.label not in STATUS_LABELS:
        raise Env("unknown status label %s (one of %s)" % (a.label, ", ".join(STATUS_LABELS)))
    cur = gh_json(["issue", "view", a.issue, "--json", "labels"])["labels"]
    drop = [l["name"] for l in cur if l["name"] in STATUS_LABELS and l["name"] != a.label]
    args = ["issue", "edit", a.issue, "--add-label", a.label]
    if drop:
        args += ["--remove-label", ",".join(drop)]
    gh(args)
    set_project_status(a.issue, a.label, load_cache())
    print("#%s -> %s" % (a.issue, a.label))


def list_projects(owner):
    return gh_json(["project", "list", "--owner", owner, "--format", "json",
                    "--limit", "100"])["projects"]


def cmd_project_init(a):
    owner, repo = repo_info()
    cache = load_cache()
    title = a.title or "%s factory" % repo
    if cache.get("projectId") and cache.get("statusFieldId") and not a.title:
        print("project #%s cached" % cache["projectNumber"])
        return
    found = [p for p in list_projects(owner) if p["title"] == title]
    if found:
        proj = found[0]
    else:
        proj = gh_json(["project", "create", "--owner", owner, "--title", title,
                        "--format", "json"])
    gh(["project", "link", str(proj["number"]), "--owner", owner, "--repo",
        "%s/%s" % (owner, repo)], check=False)
    fields = gh_json(["project", "field-list", str(proj["number"]), "--owner", owner,
                      "--format", "json"])["fields"]
    status = next((f for f in fields if f["name"] == "Status"), None)
    if status is None:
        raise Fail("project has no Status field")
    names = [o["name"] for o in status.get("options", [])]
    if not all(OPTION_NAMES[l] in names for l in STATUS_LABELS):
        try:
            opts = [{"name": OPTION_NAMES[l], "color": "GRAY", "description": l}
                    for l in STATUS_LABELS]
            opts.append({"name": "Done", "color": "GREEN", "description": "closed"})
            q = ("mutation($f:ID!,$o:[ProjectV2SingleSelectFieldOptionInput!]!){"
                 "updateProjectV2Field(input:{fieldId:$f,singleSelectOptions:$o}){"
                 "projectV2Field{... on ProjectV2SingleSelectField{id options{id name}}}}}")
            gh(["api", "graphql", "--input", "-"],
               stdin=json.dumps({"query": q, "variables": {"f": status["id"], "o": opts}}))
            fields = gh_json(["project", "field-list", str(proj["number"]), "--owner",
                              owner, "--format", "json"])["fields"]
            status = next(f for f in fields if f["name"] == "Status")
        except Fail:
            pass
    by_name = {o["name"]: o["id"] for o in status.get("options", [])}
    options = {}
    for l in STATUS_LABELS:
        oid = by_name.get(OPTION_NAMES[l]) or by_name.get(COARSE[l])
        if oid:
            options[l] = oid
    cache.update({"owner": owner, "repo": repo, "projectNumber": proj["number"],
                  "projectId": proj["id"], "statusFieldId": status["id"],
                  "options": options, "items": cache.get("items", {})})
    save_cache(cache)
    exact = all(OPTION_NAMES[l] in by_name for l in STATUS_LABELS)
    print("project #%s (%s status options)" % (proj["number"], "exact" if exact else "coarse"))


def add_item(n, cache):
    url = gh_json(["issue", "view", str(n), "--json", "url"])["url"]
    item = gh_json(["project", "item-add", str(cache["projectNumber"]), "--owner",
                    cache["owner"], "--url", url, "--format", "json"])["id"]
    cache.setdefault("items", {})[str(n)] = item
    save_cache(cache)
    return item


def cmd_add(a):
    cache = load_cache()
    if not cache.get("projectId"):
        raise Env("no project cached: run `board project-init` first")
    add_item(a.issue, cache)
    labels = [l["name"] for l in gh_json(["issue", "view", a.issue, "--json", "labels"])["labels"]]
    for l in STATUS_LABELS:
        if l in labels:
            set_project_status(a.issue, l, cache)
            break
    print("added #%s to project" % a.issue)


def blockers_open(n):
    p = gh(["api", "--paginate",
            "repos/{owner}/{repo}/issues/%s/dependencies/blocked_by" % n,
            "--jq", ".[] | select(.state == \"open\") | .number"], check=False)
    if p.returncode != 0:
        raise Fail("dependencies of #%s: %s" % (n, p.stderr.strip()))
    return [int(x) for x in p.stdout.split()]


def cmd_frontier(a):
    issues = gh_json(["issue", "list", "--state", "open", "--limit", "1000",
                      "--json", "number,body,labels"])
    out = []
    for i in sorted(issues, key=lambda x: x["number"]):
        m = re.search(r"<!-- factory:issue=(\S+) -->", i.get("body") or "")
        if not m or m.group(1) == "epic":  # the epic is a parent, not work
            continue
        if not blockers_open(i["number"]):
            out.append(i)
    for i in out:
        print(i["number"])
    if a.queue:
        for i in out:
            if any(l["name"] in STATUS_LABELS for l in i["labels"]):
                continue
            a2 = argparse.Namespace(issue=str(i["number"]), label="factory:queued")
            cmd_status(a2)


def cmd_comment(a):
    marker = "<!-- factory:step=%s -->" % a.step
    comments = gh_json(["issue", "view", a.issue, "--json", "comments"])["comments"]
    if any(marker in (c.get("body") or "") for c in comments):
        print("skipped: #%s already has step %s" % (a.issue, a.step))
        return
    body = "%s\n%s\n\n%s\n" % (DISCLAIMER, marker, read_body(a.body_file).strip())
    gh(["issue", "comment", a.issue, "--body-file", "-"], stdin=body)
    print("commented on #%s (%s)" % (a.issue, a.step))


def cmd_list(a):
    issues = gh_json(["issue", "list", "--state", "all", "--limit", "1000",
                      "--json", "number,state,body,labels"])
    for i in sorted(issues, key=lambda x: x["number"]):
        m = re.search(r"<!-- factory:issue=(\S+) -->", i.get("body") or "")
        if not m:
            continue
        labs = ",".join(l["name"] for l in i["labels"])
        print("%s\t%s\t%s\t%s" % (i["number"], m.group(1), i["state"].lower(), labs))


def cmd_edit(a):
    old = gh_json(["issue", "view", a.issue, "--json", "body"])["body"] or ""
    m = re.search(r"<!-- factory:issue=\S+ -->", old)
    body = read_body(a.body_file)
    if m and m.group(0) not in body:
        body = body.rstrip("\n") + "\n\n" + m.group(0) + "\n"
    gh(["issue", "edit", a.issue, "--body-file", "-"], stdin=body)
    print("rewrote #%s" % a.issue)


def cmd_close(a):
    gh(["issue", "close", a.issue, "--reason", a.reason.replace("-", " ")])
    print("closed #%s (%s)" % (a.issue, a.reason))


def build_parser():
    ap = argparse.ArgumentParser(
        prog="board",
        description="Every GitHub issue and Project write the factory makes. "
                    "Run from the target repo. Exit 0 ok, 1 failed, 2 usage/env.")
    sub = ap.add_subparsers(dest="cmd", metavar="<command>")
    sub.required = True

    def add(name, fn, help_):
        p = sub.add_parser(name, help=help_, description=help_)
        p.set_defaults(fn=fn)
        return p

    add("labels", cmd_labels, "create the factory label set (idempotent)")
    p = add("create", cmd_create,
            "create an issue, or print the existing one with the same marker key")
    p.add_argument("--title", required=True)
    p.add_argument("--body-file", required=True, help="path, or - for stdin")
    p.add_argument("--label", action="append")
    p.add_argument("--key", help="idempotency key (default: slug of the title)")
    p = add("sub-issue", cmd_sub_issue, "make <child> a sub-issue of <parent>")
    p.add_argument("parent")
    p.add_argument("child")
    p = add("blocked-by", cmd_blocked_by, "record that <issue> is blocked by <blocker>")
    p.add_argument("issue")
    p.add_argument("blocker")
    p = add("status", cmd_status,
            "swap the factory:* status label and the Project Status field")
    p.add_argument("issue")
    p.add_argument("label", help="one of: " + ", ".join(STATUS_LABELS))
    p = add("project-init", cmd_project_init,
            "create or find the Project and cache its ids in .factory/board.json")
    p.add_argument("--title")
    p = add("add", cmd_add, "add an issue to the Project")
    p.add_argument("issue")
    p = add("frontier", cmd_frontier,
            "print open factory issues whose blockers are all closed")
    p.add_argument("--queue", action="store_true",
                   help="set them to factory:queued (skips issues that already have a status label)")
    p = add("comment", cmd_comment,
            "post a factory comment once per step marker")
    p.add_argument("issue")
    p.add_argument("--step", required=True)
    p.add_argument("--body-file", required=True, help="path, or - for stdin")
    p = add("list", cmd_list,
            "print number, key, state, labels (tab-separated) of factory issues")
    p = add("edit", cmd_edit,
            "rewrite an issue body, keeping its hidden key marker")
    p.add_argument("issue")
    p.add_argument("--body-file", required=True, help="path, or - for stdin")
    p = add("close", cmd_close, "close an issue")
    p.add_argument("issue")
    p.add_argument("--reason", choices=["completed", "not-planned"],
                   default="completed")
    return ap


def main():
    a = build_parser().parse_args()
    try:
        a.fn(a)
    except Env as e:
        print("board: %s" % e, file=sys.stderr)
        return 2
    except Fail as e:
        print("board: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
